model HonourableResponsibility {
  responsibility_id   String @id @default(uuid())
  responsibility_name String @unique

  teacher_id String?
  teacher    Teacher? @relation(fields: [teacher_id], references: [teacher_id], onDelete: Restrict, onUpdate: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime? @updatedAt

  @@map("responsibilities")
}

