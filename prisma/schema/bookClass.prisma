model BookClass{
    book_id String
    class_id String

    book Book @relation(fields: [book_id], references: [book_id])
    class Class @relation(fields: [class_id], references: [class_id])

    createdById String?
    createdBy User? @relation(fields: [createdById], references: [user_id],  onDelete: SetNull, onUpdate: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@id([book_id,class_id])
}