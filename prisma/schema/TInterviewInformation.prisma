model TInterviewInformation {
  interview_information_id String @id @default(uuid())
  writen_marks             Float?
  viva_voice_mark          Float?
  practical_mark           Float?
  total_mark               Float?

  joining_history_id String?          @unique
  joining_history    TJoiningHistory? @relation(fields: [joining_history_id], references: [joining_history_id], onDelete: Cascade, onUpdate: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime? @updatedAt

  @@map("interview_information")
}
