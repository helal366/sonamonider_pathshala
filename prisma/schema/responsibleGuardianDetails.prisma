model ResponsibleGuardianDetails{
    responsible_guardian_id String @id @default(uuid())
    guardian String
    nid_no String?
    occupation String?
    job_title String?
    educational_qualification EducationDegree?
    monthly_income String?
    mobile_no_1 String?
    mobile_no_2 String?
    mobile_no_3 String?

    students Student[]

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@map("responsible_guardians")
}