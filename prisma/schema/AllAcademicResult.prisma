model AcademicResult {
  academic_result_id String  @id @default(uuid())
  ssc_result         String?
  dakhil_result      String?
  hsc_result         String?
  alim_result        String?
  hons_result        String?
  fazil_result       String?
  masters_result     String?
  kamil              String?

  teacher_id String?  @unique
  teacher    Teacher? @relation(fields: [teacher_id], references: [teacher_id], onDelete: Cascade, onUpdate: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime? @updatedAt

  @@map("academic_results")
}
